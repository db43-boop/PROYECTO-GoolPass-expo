*.bak
*.backup
*~
*.orig
*.swp

# Scripts de prueba / verificacion temporal (prefijo _ o sufijo _test / test_)
_test_*
*_test.php
test_*.php

# Archivos temporales varios
*.tmp
*.temp
desktop.ini
