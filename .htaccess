Options -Indexes
# Archivos privados, bases de datos y scripts no deben descargarse.
<FilesMatch "(?i)\.(?:db|sqlite|sqlite3|env|ini|log|bak|backup)$">
    Require all denied
</FilesMatch>

DirectoryIndex public/index.php
RewriteEngine On
RewriteRule ^public/index\.php$ - [L]
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^ public/index.php [QSA,L]
